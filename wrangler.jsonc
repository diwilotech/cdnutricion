{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdnutricion",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Solo se publica en el dominio propio (cdnutricion.diwilo.com).
  // Diwilo Web llega por service binding, sin pasar por el dominio.
  "workers_dev": false,
  "preview_urls": false,

  // Conserva las variables cargadas en el dashboard en cada deploy.
  "keep_vars": true,

  // En Workers Builds (WORKERS_CI=1) aplica las migraciones de D1 pendientes antes de desplegar.
  // En local no hace nada. Si una migración falla, el despliegue se detiene.
  "build": {
    "command": "sh -c 'if [ -n \"$WORKERS_CI\" ]; then npx wrangler d1 migrations apply cdnutricion --remote; fi'"
  },

  // Frontend: HTML sueltas servidas por el mismo Worker.
  // /api/* y /admin/* pasan primero por el Worker (sesión + tenant).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin", "/admin/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cdnutricion",
      "database_id": "3dc82375-5088-44c0-920c-f0aea7ddc503",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "cdnutricion-files" }
  ],

  "vars": {
    "APP_NAME": "CD Nutrición",
    "DEFAULT_COUNTRY_CODE": "57",
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_PORT": "465"
  }

  // Secretos (wrangler secret put <NOMBRE>), no van en el repo:
  //   SMTP_USER / SMTP_PASS  cuenta Gmail + contraseña de aplicación
  //   EVOLUTION_URL / EVOLUTION_KEY  servidor Evolution API
}

{
  "name": "cdnutricion",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply cdnutricion --local --persist-to .wrangler/state",
    "db:seed:local": "wrangler d1 execute cdnutricion --local --file=scripts/seed.sql",
    "db:migrate:remote": "wrangler d1 migrations apply cdnutricion --remote",
    "test": "node scripts/test-local.mjs",
    "deploy": "wrangler d1 migrations apply cdnutricion --remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.153.0"
  }
}
